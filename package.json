{
  "name": "lore-memory",
  "version": "0.5.2",
  "description": "Persistent project memory for developers. Captures decisions, invariants, gotchas, and graveyard entries — automatically and manually — and injects them into AI coding sessions.",
  "main": "bin/lore.js",
  "bin": {
    "lore": "./bin/lore.js"
  },
  "scripts": {
    "test": "jest",
    "lint": "eslint src/ bin/",
    "format": "prettier --write \"{src,bin}/**/*.js\"",
    "typecheck": "tsc -p jsconfig.json --noEmit",
    "prepare": "husky",
    "changeset": "changeset",
    "version": "changeset version",
    "release": "changeset publish"
  },
  "files": [
    "bin/",
    "src/",
    "README.md",
    "LICENSE",
    "CHANGELOG.md"
  ],
  "engines": {
    "node": ">=18.0.0"
  },
  "overrides": {
    "human-id": "4.1.1"
  },
  "lint-staged": {
    "*.js": [
      "eslint --fix",
      "prettier --write"
    ]
  },
  "keywords": [
    "lore",
    "memory",
    "decisions",
    "architecture",
    "ai",
    "claude",
    "mcp",
    "context",
    "knowledge-base",
    "developer-tools",
    "cli"
  ],
  "author": "Tushar Jindal",
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/Tjindl/Lore.git"
  },
  "homepage": "https://github.com/Tjindl/Lore#readme",
  "bugs": {
    "url": "https://github.com/Tjindl/Lore/issues"
  },
  "dependencies": {
    "@babel/parser": "^7.29.0",
    "@modelcontextprotocol/sdk": "^1.27.1",
    "better-sqlite3": "^12.6.2",
    "chalk": "^4",
    "chokidar": "^3.6.0",
    "commander": "^11",
    "express": "^5.2.1",
    "fs-extra": "^11",
    "glob": "^10.5.0",
    "inquirer": "^8",
    "js-yaml": "^4",
    "natural": "^6.12.0",
    "ollama": "^0.6.3",
    "open": "^11.0.0"
  },
  "devDependencies": {
    "@changesets/cli": "^2.31.1",
    "@types/node": "^26.1.1",
    "eslint": "^8.57.1",
    "eslint-config-prettier": "^10.1.8",
    "eslint-plugin-prettier": "^5.5.6",
    "husky": "^9.1.7",
    "jest": "^30.3.0",
    "lint-staged": "^17.2.0",
    "prettier": "^3.9.6",
    "typescript": "^7.0.2"
  }
}
